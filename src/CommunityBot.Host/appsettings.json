{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=communitybot;Username=communitybot;Password=communitybot"
  },

  "Discord": {
    "Enabled": false,
    "GuildId": 0,
    "Roles": {}
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      }
    ],

    "Enrich": [
      "FromLogContext"
    ]
  }
}